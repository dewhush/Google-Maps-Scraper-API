# ===========================================
# Google Maps Scraper API - Environment Variables
# ===========================================
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control!

# ===========================================
# Email Configuration (Resend)
# ===========================================
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM=your-verified-email@domain.com

# ===========================================
# Database (Supabase)
# ===========================================
# Get credentials from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ===========================================
# Authentication
# ===========================================
# Generate a strong random key (32+ characters)
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-jwt-key-change-in-production

# ===========================================
# Optional: Telegram Monitoring
# ===========================================
# For real-time security alerts and traffic monitoring
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id

# ===========================================
# Optional: Deployment
# ===========================================
# Set to 'true' when deploying to Render.com
# RENDER=false
