# ===========================================
# LeadMaps Environment Variables
# ===========================================

# Email Configuration (Resend)
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM=team@leadmaps.web.id

# Authentication
SECRET_KEY=your_secret_key_here

# Render Configuration (set automatically by Render)
RENDER=false

# Frontend API URL (for production, set to your backend URL)
# VITE_API_URL=https://leadmaps-backend.onrender.com/api
